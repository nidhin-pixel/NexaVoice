VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_AGORA_APP_ID=your-agora-app-id
# Optional; defaults to ${VITE_SUPABASE_URL}/functions/v1
VITE_AGORA_API_BASE=https://your-project.supabase.co/functions/v1

# Supabase Edge Function secrets (set with `supabase secrets set`; never expose in Vite):
# AGORA_APP_ID
# AGORA_APP_CERTIFICATE
# AGORA_CUSTOMER_ID
# AGORA_CUSTOMER_SECRET
# AGORA_AGENT_NAME
# AGORA_AGENT_UID
# AGORA_PIPELINE_ID
# RESEND_API_KEY
# FOLLOWUP_FROM_EMAIL
